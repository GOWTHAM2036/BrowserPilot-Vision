# BrowserPilot Vision Environment Configuration

# Ollama API Configuration
OLLAMA_BASE_URL=http://localhost:11434
# Default model (gemma3:4b, qwen3:4b, or qwen2.5:1.5b-instruct-q4_K_M)
DEFAULT_MODEL=gemma3:4b

# Hardware & LLM Inference Constraints (Tuned for 4GB VRAM)
CONTEXT_SIZE=4096
REQUEST_TIMEOUT=120.0

# Agent Execution Limits
MAX_AGENT_STEPS=12
MAX_OBSERVATION_CHARS=3000

# Security & Safety Policies
# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1
ENFORCE_HTTPS=false

# Browser Automation
HEADLESS=true
BROWSER_ACTION_TIMEOUT=5000

# Storage & Logging
LOG_DIR=data

# Web UI & Backend Integration
BROWSERPILOT_BACKEND_URL=http://127.0.0.1:8000
